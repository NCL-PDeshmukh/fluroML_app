    else:
        em_smiles = st_ketcher("")

    solvent_em = st.text_input("Solvent SMILES (e.g., 'O' for water):", key="em_solvent")

    if em_smiles and solvent_em and model_emission:
        desc_smiles = smiles_to_descriptors(em_smiles)
        desc_solvent = smiles_to_descriptors(solvent_em)
        if desc_smiles is not None and desc_solvent is not None:
            features = pd.concat([desc_smiles, desc_solvent], axis=1)
            with st.spinner("Predicting Emission..."):
                pred = predict(model_emission, features)
            st.image(draw_molecule(em_smiles), caption="Molecule Structure")
            if pred is not None:
                st.success(f"Predicted Emission Max: {pred:.2f} nm")

# ----------------------------
# Tab 4: FRET Analysis
# ----------------------------
with tab4:
    st.markdown("## 🔬 FRET Pair Analysis")
    method = st.radio("Donor Input:", ("SMILES Input", "Draw Molecule", "Upload File"), key="fret_method")
    donor_smiles = ""

    if method == "SMILES Input":
        donor_smiles = st.text_input("Donor SMILES:", key="fret_donor")
    elif method == "Upload File":
        file = st.file_uploader("Upload donor molecule", type=["smi", "mol", "sdf"], key="fret_file")
        if file: donor_smiles = read_molecule_file(file) or ""
    else:
        donor_smiles = st_ketcher("")

    if donor_smiles and model_emission:
        df = load_dataset()
        if df is not None:
            # ✅ Corrected column names
            required_cols = {"Smiles", "AbsorptionMax (nm)", "EmissionMax (nm)", "Fluorescent labeling"}
            if required_cols.issubset(df.columns):
                donor_desc = smiles_to_descriptors(donor_smiles)
                solvent_desc = smiles_to_descriptors("O")  # assume water
                if donor_desc is not None and solvent_desc is not None:
                    features = pd.concat([donor_desc, solvent_desc], axis=1)
                    donor_em = predict(model_emission, features)
                    if donor_em is not None:
                        df_cand = df[df["Fluorescent labeling"].astype(str).str.lower().isin(["yes", "true", "1"])]
                        df_cand = df_cand[df_cand["AbsorptionMax (nm)"].notna()]
                        df_cand = df_cand[df_cand["Smiles"] != donor_smiles]

                        if not df_cand.empty:
                            df_cand["abs_diff"] = (df_cand["AbsorptionMax (nm)"] - donor_em).abs()
                            best = df_cand.sort_values("abs_diff").iloc[0]
                            best_smiles = best["Smiles"]
                            best_abs = best["AbsorptionMax (nm)"]
                            best_em = best["EmissionMax (nm)"]
                            fret_eff = (best_abs / (donor_em + best_abs)) * 100

                            col1, col2 = st.columns(2)
                            with col1:
                                st.image(draw_molecule(donor_smiles), caption="Donor Molecule")
                                st.write(f"**Predicted Donor Emission:** {donor_em:.2f} nm")
                            with col2:
                                st.image(draw_molecule(best_smiles), caption="Top Acceptor")
                                st.write(f"**Acceptor Absorption:** {best_abs:.2f} nm")
                                if pd.notna(best_em):
                                    st.write(f"**Acceptor Emission:** {best_em:.2f} nm")
                                st.write(f"**FRET Efficiency:** {fret_eff:.2f}%")

                            st.markdown("**Top 5 Matches:**")
                            st.dataframe(df_cand.nsmallest(5, "abs_diff")[["Smiles", "AbsorptionMax (nm)", "EmissionMax (nm)", "abs_diff"]])
            else:
                st.error("Dataset missing required columns.")

